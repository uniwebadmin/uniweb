Options -Indexes
DirectoryIndex index.php

# Branded UniWeb errors (not the host default page)
ErrorDocument 403 /error.php
ErrorDocument 404 /error.php
ErrorDocument 500 /error.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=(self)"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; frame-src 'self' https:; form-action 'self' https:; base-uri 'self'; frame-ancestors 'self'; object-src 'none'"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

<FilesMatch "\.(env|log|sql|md)$|^(config\.private\.php|db_backup.*\.json|db_.*_result\.json)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(debug_|wallet_fix_|wallet_diagnose|update_v|my_secret_setup|night_setup|morning_ops|axis_probe|diag\.php|diag_|test_|refresh_|update_mdr|update_axis_keys|platform_wallet_fix|db_reset_|db_backup_)">
    Require all denied
</FilesMatch>

# Block diagnostic / setup leak pages by exact name
<Files "diag.php">
    Require all denied
</Files>
<Files "wallet_diagnose.php">
    Require all denied
</Files>
<Files "debug_schema.php">
    Require all denied
</Files>
<Files "db_probe.php">
    Require all denied
</Files>
<Files "db_wizard.php">
    Require all denied
</Files>
<Files "config_repair.php">
    Require all denied
</Files>
<Files "fix_config.php">
    Require all denied
</Files>
<Files "cleanup.php">
    Require all denied
</Files>
<Files "cleanup2.php">
    Require all denied
</Files>
<Files "migrate_legacy_kyc.php">
    Require all denied
</Files>

# Block entire dev_local directory from web access
<IfModule mod_rewrite.c>
    RewriteRule ^dev_local/ - [F]
    RewriteRule ^tests/ - [F]
    RewriteRule ^scripts/ - [F]
    RewriteRule ^training/ - [F]
    RewriteRule ^docs/ - [F]
    RewriteRule ^archive/ - [F]
    RewriteRule ^_inbox/ - [F]
    # Block direct access to private storage (KYC docs, evidence packs)
    RewriteRule ^storage/ - [F]
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Clean URLs (no .php in browser)
    RewriteRule ^pay/([A-Za-z0-9]+)/?$ checkout.php?link=$1 [L,QSA]
    RewriteRule ^checkout/([A-Za-z0-9]+)/?$ checkout.php?link=$1 [L,QSA]
    RewriteRule ^demo/?$ demo.php [L]
    RewriteRule ^about/?$ about.php [L]
    RewriteRule ^register/?$ merchant_register.php [L]
    RewriteRule ^login/?$ login.php [L]
    RewriteRule ^admin/?$ admin_login.php [L]
    # /cust may be blocked or shadowed on some Hostinger setups — keep try + /payer alias
    RewriteRule ^cust/?$ /customer_login.php [L,QSA,R=302]
    RewriteRule ^customer/?$ /customer_login.php [L,QSA,R=302]
    RewriteRule ^payer/?$ /customer_login.php [L,QSA,R=302]

    # API versioning: /api/v1/ -> api.php (backward compatible — api.php still works directly)
    RewriteRule ^api/v1/?$ api.php [L,QSA]
    RewriteRule ^api/v1/index\.php$ api.php [L,QSA]
</IfModule>
