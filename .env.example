# UniWeb .env — copy to .env and fill with real values
# .env is gitignored — never commit real credentials

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uniweb
DB_USER=uniweb
DB_PASS=uniweb_dev

# App
APP_NAME=UniWeb
APP_URL=http://localhost:8000
UNIWEB_DISPLAY_ERRORS=1

# Gateway keys (paste when received)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
PAYU_MERCHANT_KEY=
PAYU_SALT=
AXIS_CLIENT_ID=
AXIS_CLIENT_SECRET=
DECENTRO_CLIENT_ID=
DECENTRO_CLIENT_SECRET=

# Security
SESSION_SECURE=0
