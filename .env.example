# UniWeb .env — copy to .env and fill with real values
# .env is gitignored — never commit real credentials

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uniweb
DB_USER=uniweb
DB_PASS=uniweb_dev

# App
APP_NAME=UniWeb
APP_URL=http://localhost:8000
# Set UNIWEB_DISPLAY_ERRORS=0 and APP_ENV=production on live to hide PHP/SQL stack traces
UNIWEB_DISPLAY_ERRORS=1
APP_ENV=local

# Gateway keys (paste when received)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
PAYU_MERCHANT_KEY=
PAYU_SALT=
AXIS_CLIENT_ID=
AXIS_CLIENT_SECRET=
DECENTRO_CLIENT_ID=
DECENTRO_CLIENT_SECRET=

# Security
SESSION_SECURE=0

# Encryption key for PII (AES-256-GCM) — 32 raw bytes, base64 encoded
# Generate with: php -r "echo base64_encode(random_bytes(32));"
ENCRYPTION_KEY=

# Private storage path (outside public_html on production)
UNIWEB_PRIVATE_DIR=
